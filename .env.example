# --- Supabase (Projet > Settings > API) ---
# URL publique du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://setltmifcpeelqikizmc.supabase.co

# Clé publique "anon" : exposée au navigateur, protégée par les policies RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_4uTO2F8mhrGuYG-UZryHug_CwLSUu-Z

# Clé "service_role" : SECRÈTE, serveur uniquement -FACULTATIVE en V1.
# Aucune page ni route de l'application ne l'utilise : le parcours visiteur et
# le parcours administrateur passent tous deux par RLS. Laissez cette ligne
# vide ou commentée tant que vous n'ajoutez pas de tâche d'administration.
#
# Où la trouver : Project Settings > API Keys.
#   · Nouveau système : bouton "Create secret key" (format sb_secret_...)
#   · Ancien système  : onglet "Legacy API keys" > service_role > Reveal
#
# Ne JAMAIS la préfixer par NEXT_PUBLIC_, ni l'importer dans un composant client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
# Version du texte de consentement enregistrée avec chaque visiteur
NEXT_PUBLIC_CONSENT_VERSION=1.0

# URL publique de l'application (utilisée pour les liens absolus)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
